# Copy to .env and fill locally. Never commit the real .env.
GEOAPIFY_API_KEY=
# Private AI server: HTTPS URLs and server-only bearer tokens.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_SERVICE_KEY=
GEMMA_MODEL=gemma3:4b
SHIELDGEMMA_URL=
SHIELDGEMMA_SERVICE_KEY=
# Enable only after labelled evaluation of both policy models.
SHIELDGEMMA_VALIDATED=0
# Free Render staging stays read-only until storage is connected.
PUBLIC_POSTING_ENABLED=0
DATABASE_URL=
ROAM_MODERATOR_KEY=
# Stable 32-byte key represented by 64 hexadecimal characters.
ROAM_PROVENANCE_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0
